QMainWindow { background: #17181a; }
QToolBar { background: #232428; border: none; padding: 4px; spacing: 2px; }
QToolBar QToolButton { color: #d8d9db; background: #2b2d32; border: 1px solid #3f4147;
                       border-radius: 6px; padding: 5px 9px; font-size: 13px; }
QToolBar QToolButton:hover { background: #34363c; border-color: #4f5258; }
QToolBar QToolButton:pressed { background: #26282c; border-color: #4f5258; }
QToolBar QToolButton:checked { background: #0a84ff; border-color: #0a84ff; color: white; }
QStatusBar { background: #232428; color: #b9bbc0; }
/* QStatusBar{color} 不会继承给子 QLabel（实测黑色），必须显式命中 */
QStatusBar QLabel { color: #b9bbc0; background: transparent; }
QStatusBar::item { border: none; }
QListWidget#thumbPanel { background: #1c1d20; border: none; }
QListWidget#thumbPanel::item { color: #c9cace; border-radius: 6px; padding: 4px; }
QListWidget#thumbPanel::item:hover { background: #2b2d32; }
QListWidget#thumbPanel::item:selected { background: #0a84ff; color: white; }
/* 画布与底部缩略图条之间的拖拽分隔条 */
QSplitter#centerSplit::handle { background: #2b2d32; height: 6px; }
QSplitter#centerSplit::handle:hover { background: #3f4147; }
QGraphicsView#canvas { background: #17181a; }
QToolTip { background: #2b2d32; color: #e6e7e9; border: 1px solid #3f4147; }
/* 自定义标题栏（setMenuWidget 挂在窗口最顶，工具栏之上） */
QWidget#titleBar { background: #17181a; }
QLabel#lblApp { color: #d8d9db; font-size: 12px; }
#titleBar QPushButton { background: transparent; border: none; color: #d8d9db;
                        padding: 0 10px; min-width: 26px; min-height: 32px; }
#titleBar QPushButton:hover { background: #2b2d32; }
#titleBar QPushButton#btnClose:hover { background: #c42b1c; color: white; }

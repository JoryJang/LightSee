QMainWindow { background: #f5f6f8; }
QToolBar { background: #e8eaee; border: none; padding: 4px; spacing: 2px; }
QToolBar QToolButton { color: #333538; background: #ffffff; border: 1px solid #cdd1d7;
                       border-radius: 6px; padding: 5px 9px; font-size: 13px; }
QToolBar QToolButton:hover { background: #f0f1f4; border-color: #b7bcc3; }
QToolBar QToolButton:pressed { background: #e2e4e8; border-color: #b7bcc3; }
QToolBar QToolButton:checked { background: #0a6ed1; border-color: #0a6ed1; color: white; }
QStatusBar { background: #e8eaee; color: #55585e; }
/* 与 dark.qss 同理：QStatusBar{color} 不继承给子 QLabel，必须显式命中 */
QStatusBar QLabel { color: #55585e; background: transparent; }
QStatusBar::item { border: none; }
QListWidget#thumbPanel { background: #ffffff; border: none; }
QListWidget#thumbPanel::item { color: #333538; border-radius: 6px; padding: 4px; }
QListWidget#thumbPanel::item:hover { background: #eceef1; }
QListWidget#thumbPanel::item:selected { background: #0a6ed1; color: white; }
/* 画布与底部缩略图条之间的拖拽分隔条 */
QSplitter#centerSplit::handle { background: #d8dade; height: 6px; }
QSplitter#centerSplit::handle:hover { background: #b9bec6; }
QGraphicsView#canvas { background: #f5f6f8; }
QToolTip { background: #ffffff; color: #333538; border: 1px solid #cdd1d7; }
/* 自定义标题栏（setMenuWidget 挂在窗口最顶，工具栏之上） */
QWidget#titleBar { background: #f5f6f8; }
QLabel#lblTitle { color: #333538; font-size: 12px; }
#titleBar QPushButton { background: transparent; border: none; color: #333538;
                        padding: 0 10px; min-width: 26px; }
#titleBar QPushButton:hover { background: #e2e4e8; }
#titleBar QPushButton#btnClose:hover { background: #c42b1c; color: white; }
